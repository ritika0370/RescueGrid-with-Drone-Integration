# ==============================================================================
# DISASTER RESPONSE AND RESCUE COORDINATION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project
PROJECT_NAME="Disaster Response and Rescue Coordination Platform"
VERSION="1.0.0"
DEBUG=false
API_V1_STR="/api/v1"

# Security & JWT Token Signing (Change this in production)
SECRET_KEY="disaster-response-secure-key-2026-production-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# PostgreSQL (Production / Docker):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/disaster_db"
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/disaster_db"

# Local SQLite fallback option (for instant local zero-dependency testing):
# DATABASE_URL="sqlite+aiosqlite:///./disaster_platform.db"
# DATABASE_SYNC_URL="sqlite:///./disaster_platform.db"

# Redis Event Bus & Queue
REDIS_URL="redis://localhost:6379/0"

# Local Storage Directories
STORAGE_TYPE="local"
STORAGE_DIR="./uploads"

# AI Multimodal Model Providers
VISION_PROVIDER="simulated"     # Options: "simulated", "yolov8"
YOLO_MODEL_PATH="yolov8n.pt"
STT_PROVIDER="configurable"      # Options: "configurable", "whisper", "twilio"
OPENAI_API_KEY=""

# ==============================================================================
# TWILIO EMERGENCY VOICE HOTLINE INTEGRATION
# ==============================================================================
# Credentials left as placeholders by default as requested:
TWILIO_ACCOUNT_SID="AC_TWILIO_PLACEHOLDER_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="TWILIO_PLACEHOLDER_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="+18005550199"

# Webhook Base URL (Set to your public domain or ngrok tunnel URL when receiving live calls from Twilio)
TWILIO_WEBHOOK_BASE_URL="http://localhost:8000"

# Incident Grouping Engine Thresholds
GROUPING_MAX_DISTANCE_KM=3.5
GROUPING_TIME_WINDOW_HOURS=6.0
GROUPING_HIGH_CONFIDENCE_THRESHOLD=0.70
GROUPING_MEDIUM_CONFIDENCE_THRESHOLD=0.35
